---
import '../styles/global.css';

interface Props {
  title: string;
  activeTab?: 'budget' | 'reserved' | 'scan' | 'insights' | 'settings';
  hideTabBar?: boolean;
}

const { title, activeTab = 'budget', hideTabBar = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <title>{title} — SnapBudget</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
</head>
<body class="bg-[#faf9fe] text-[#1a1b1f] flex flex-col min-h-screen selection:bg-[#d8e2ff]">
  <!-- Apple HIG Status Bar + Header -->
  <header class="fixed top-0 inset-x-0 z-50 bg-[#faf9fe]/85 backdrop-blur-xl pt-safe border-b border-[#e3e2e7]/40">
    <div class="h-11 px-6 flex items-center justify-between text-xs">
      <span class="font-semibold text-sm tracking-tight">9:41</span>
      <div class="flex items-center gap-1.5 text-xs">
        <span class="material-symbols-outlined text-[16px]">signal_cellular_4_bar</span>
        <span class="material-symbols-outlined text-[16px]">wifi</span>
        <span class="material-symbols-outlined text-[20px]">battery_full</span>
      </div>
    </div>
  </header>

  <!-- Main View Area -->
  <main class={`flex-1 flex flex-col relative w-full pt-[44px] ${hideTabBar ? 'pb-6' : 'pb-28'} px-4 max-w-md mx-auto`}>
    <slot />
  </main>

  <!-- Apple HIG Floating / Frosted Glass Tab Bar -->
  {!hideTabBar && (
  <nav class="fixed bottom-0 inset-x-0 z-50 pb-safe bg-[#faf9fe]/90 backdrop-blur-2xl border-t border-[#e3e2e7]/60">
    <div class="flex justify-around items-center h-16 max-w-md mx-auto px-2">
      <!-- Budget Tab -->
      <a href="/" class={`flex-1 flex flex-col items-center justify-center h-full transition-colors ${activeTab === 'budget' ? 'text-[#007aff] font-semibold' : 'text-[#717786] hover:text-[#1a1b1f]'}`}>
        <span class="material-symbols-outlined text-[24px]">account_balance_wallet</span>
        <span class="text-[11px] mt-0.5">Budget</span>
      </a>

      <!-- Reserved Tab -->
      <a href="/reserved" class={`flex-1 flex flex-col items-center justify-center h-full transition-colors ${activeTab === 'reserved' ? 'text-[#007aff] font-semibold' : 'text-[#717786] hover:text-[#1a1b1f]'}`}>
        <span class="material-symbols-outlined text-[24px]">shield</span>
        <span class="text-[11px] mt-0.5">Reserved</span>
      </a>

      <!-- Scan FAB Action (Primary Highlight) -->
      <a href="/scan" class="flex-1 flex flex-col items-center justify-center h-full group">
        <div class="w-12 h-12 -mt-5 rounded-full bg-[#007aff] text-white flex items-center justify-center shadow-lg shadow-[#007aff]/35 transition-transform active:scale-95">
          <span class="material-symbols-outlined text-[26px]">photo_camera</span>
        </div>
        <span class="text-[11px] mt-1 text-[#007aff] font-medium">Scan</span>
      </a>

      <!-- Insights Tab -->
      <a href="/insights" class={`flex-1 flex flex-col items-center justify-center h-full transition-colors ${activeTab === 'insights' ? 'text-[#007aff] font-semibold' : 'text-[#717786] hover:text-[#1a1b1f]'}`}>
        <span class="material-symbols-outlined text-[24px]">analytics</span>
        <span class="text-[11px] mt-0.5">Insights</span>
      </a>

      <!-- Coverage / Calculator Tab -->
      <a href="/calculator" class={`flex-1 flex flex-col items-center justify-center h-full transition-colors ${activeTab === 'settings' ? 'text-[#007aff] font-semibold' : 'text-[#717786] hover:text-[#1a1b1f]'}`}>
        <span class="material-symbols-outlined text-[24px]">tune</span>
        <span class="text-[11px] mt-0.5">Plan</span>
      </a>
    </div>

    <!-- Apple Home Indicator Bar -->
    <div class="flex justify-center items-center pb-1">
      <div class="w-32 h-1 bg-[#1a1b1f]/20 rounded-full"></div>
    </div>
  </nav>
  )}
</body>
</html>
