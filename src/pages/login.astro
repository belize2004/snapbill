---
import '../styles/global.css';

const error = Astro.url.searchParams.get('error');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>Passcode — SnapBudget</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
</head>
<body class="bg-[#faf9fe] text-[#1a1b1f] flex flex-col justify-center items-center min-h-screen p-6 selection:bg-[#d8e2ff]">
  <div class="w-full max-w-sm flex flex-col items-center text-center space-y-6">
    <!-- Lock Icon / FaceID Avatar -->
    <div class="w-20 h-20 rounded-3xl bg-[#007aff]/15 flex items-center justify-center text-[#007aff] shadow-sm">
      <span class="material-symbols-outlined text-[42px]">lock</span>
    </div>

    <div>
      <h1 class="text-2xl font-bold tracking-tight text-[#1a1b1f]">Enter Passcode</h1>
      <p class="text-xs text-[#717786] mt-1">bills.flowwebdesigner.com</p>
    </div>

    <!-- Passcode Form -->
    <form action="/api/login" method="POST" class="w-full space-y-4">
      <div>
        <input
          type="password"
          name="passcode"
          id="passcodeInput"
          inputmode="numeric"
          pattern="[0-9]*"
          maxlength="8"
          autofocus
          placeholder="••••"
          required
          class="w-full text-center text-3xl tracking-[0.4em] font-bold bg-white px-4 py-4 rounded-2xl border border-[#e3e2e7]/70 shadow-sm focus:outline-none focus:ring-2 focus:ring-[#007aff]"
        />
      </div>

      {error && (
        <div class="p-2.5 rounded-xl bg-[#ba1a1a]/10 text-[#ba1a1a] text-xs font-semibold">
          Incorrect passcode. Try again.
        </div>
      )}

      <button
        type="submit"
        class="w-full py-3.5 px-4 bg-[#007aff] hover:bg-[#0070eb] active:scale-[0.99] text-white font-semibold text-sm rounded-2xl shadow-lg shadow-[#007aff]/30 transition-all flex items-center justify-center gap-2"
      >
        <span class="material-symbols-outlined text-[20px]">lock_open</span>
        Unlock
      </button>
    </form>
  </div>
</body>
</html>
