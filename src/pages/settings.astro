---
import AppLayout from '../layouts/AppLayout.astro';
import { getCloudflareBindings } from '../lib/db';

const env = await getCloudflareBindings();
const db = env?.DB;

let monthlyLimit = 0.00;
let currentSpent = 0.00;

if (db) {
  try {
    const res = await db.prepare("SELECT * FROM budget_settings WHERE id = 1").first();
    if (res) {
      monthlyLimit = Number(res.monthly_limit || 0);
      currentSpent = Number(res.current_spent || 0);
    }
  } catch (e) {
    console.error(e);
  }
}
---

<AppLayout title="Budget Settings" activeTab="settings">
  <div class="flex flex-col w-full pb-8 space-y-5 pt-3">
    <!-- Header -->
    <div class="px-1">
      <span class="text-xs font-semibold text-[#717786] uppercase tracking-wider block mb-0.5">Configuration</span>
      <h1 class="text-3xl font-bold tracking-tight text-[#1a1b1f]">Settings</h1>
    </div>

    <!-- Monthly Budget Target Card -->
    <div class="bg-white rounded-3xl p-5 shadow-sm border border-[#e3e2e7]/60 space-y-4">
      <div class="flex items-center gap-3">
        <div class="w-12 h-12 rounded-2xl bg-[#007aff]/15 flex items-center justify-center text-[#007aff]">
          <span class="material-symbols-outlined text-[26px]">account_balance</span>
        </div>
        <div>
          <span class="text-xs font-semibold text-[#717786] uppercase tracking-wider">Target Budget</span>
          <h2 class="text-xl font-bold text-[#1a1b1f] mt-0.5">Monthly Limit</h2>
        </div>
      </div>

      <div class="space-y-3 pt-2">
        <div class="space-y-1">
          <label class="text-xs font-semibold text-[#717786] uppercase tracking-wider">Total Monthly Spending Limit ($)</label>
          <input type="number" step="0.01" id="monthlyLimitInput" value={monthlyLimit > 0 ? monthlyLimit : ''} placeholder="e.g. 4200.00" class="w-full bg-[#f4f3f8] px-3.5 py-2.5 rounded-xl text-base font-bold text-[#1a1b1f] border border-[#e3e2e7]/70 focus:outline-none focus:ring-2 focus:ring-[#007aff]" />
        </div>

        <div class="space-y-1">
          <label class="text-xs font-semibold text-[#717786] uppercase tracking-wider">Spent So Far This Month ($)</label>
          <input type="number" step="0.01" id="currentSpentInput" value={currentSpent > 0 ? currentSpent : ''} placeholder="0.00" class="w-full bg-[#f4f3f8] px-3.5 py-2.5 rounded-xl text-base font-bold text-[#1a1b1f] border border-[#e3e2e7]/70 focus:outline-none focus:ring-2 focus:ring-[#007aff]" />
        </div>
      </div>

      <button id="saveBudgetBtn" class="w-full py-3 px-4 bg-[#007aff] hover:bg-[#0070eb] active:scale-[0.99] text-white font-semibold text-sm rounded-2xl shadow-md transition-all">
        Update Budget Targets
      </button>
    </div>

    <!-- Danger Zone / Reset to Zero -->
    <div class="bg-white rounded-3xl p-5 shadow-sm border border-[#ba1a1a]/30 space-y-3">
      <div class="flex items-center gap-2 text-[#ba1a1a]">
        <span class="material-symbols-outlined text-[20px]">warning</span>
        <h3 class="text-sm font-bold">Reset All Data to Zero</h3>
      </div>
      <p class="text-xs text-[#717786]">
        Delete all bills, reset monthly spending balances to $0.00, and clear the database.
      </p>
      <button id="resetAllBtn" class="w-full py-2.5 px-4 bg-[#ba1a1a]/10 hover:bg-[#ba1a1a]/20 text-[#ba1a1a] font-semibold text-xs rounded-xl transition-all">
        Wipe Everything to Zero
      </button>
    </div>
  </div>

  <script>
    document.getElementById('saveBudgetBtn')?.addEventListener('click', async () => {
      const limit = parseFloat((document.getElementById('monthlyLimitInput') as HTMLInputElement).value) || 0;
      const spent = parseFloat((document.getElementById('currentSpentInput') as HTMLInputElement).value) || 0;

      await fetch('/api/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ monthly_limit: limit, current_spent: spent })
      });
      alert('Budget updated!');
      window.location.href = '/';
    });

    document.getElementById('resetAllBtn')?.addEventListener('click', async () => {
      if (confirm('Are you sure you want to wipe all bills and reset the budget to $0.00?')) {
        await fetch('/api/reset', { method: 'POST' });
        alert('All data reset to zero.');
        window.location.href = '/';
      }
    });
  </script>
</AppLayout>
