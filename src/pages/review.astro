---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Review Scanned Bill" activeTab="scan">
  <div class="flex flex-col w-full pb-8 space-y-5 pt-3">
    <!-- Navigation Bar -->
    <div class="flex items-center justify-between px-1">
      <a href="/scan" class="flex items-center text-[#007aff] text-sm font-medium">
        <span class="material-symbols-outlined text-[20px]">chevron_left</span>
        Retake
      </a>
      <h2 class="text-base font-semibold text-[#1a1b1f]">Review Scanned Bill</h2>
      <button id="saveBillBtn" class="text-sm font-semibold text-[#007aff] active:opacity-75">
        Save
      </button>
    </div>

    <!-- Scanned Bill Status Card -->
    <div class="bg-white rounded-3xl p-5 shadow-sm border border-[#e3e2e7]/60 space-y-4">
      <div class="flex items-center gap-3">
        <div class="w-12 h-12 rounded-2xl bg-[#72fe88]/20 flex items-center justify-center text-[#006e28]">
          <span class="material-symbols-outlined text-[26px]">receipt_long</span>
        </div>
        <div>
          <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-[#72fe88]/20 text-[#006e28] text-[11px] font-semibold">
            High Confidence OCR (98%)
          </span>
          <h3 id="displayMerchant" class="text-xl font-bold text-[#1a1b1f] mt-0.5">Con Edison</h3>
        </div>
      </div>

      <!-- Editable Details Inset Form -->
      <div class="space-y-3 pt-2">
        <div class="space-y-1">
          <label class="text-xs font-semibold text-[#717786] uppercase tracking-wider">Merchant / Vendor</label>
          <input type="text" id="merchantInput" value="Con Edison" class="w-full bg-[#f4f3f8] px-3.5 py-2.5 rounded-xl text-sm font-medium text-[#1a1b1f] border border-[#e3e2e7]/70 focus:outline-none focus:ring-2 focus:ring-[#007aff]" />
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="space-y-1">
            <label class="text-xs font-semibold text-[#717786] uppercase tracking-wider">Amount ($)</label>
            <input type="number" step="0.01" id="amountInput" value="112.40" class="w-full bg-[#f4f3f8] px-3.5 py-2.5 rounded-xl text-sm font-bold text-[#1a1b1f] border border-[#e3e2e7]/70 focus:outline-none focus:ring-2 focus:ring-[#007aff]" />
          </div>
          <div class="space-y-1">
            <label class="text-xs font-semibold text-[#717786] uppercase tracking-wider">Due Date</label>
            <input type="date" id="dueDateInput" value="2026-11-28" class="w-full bg-[#f4f3f8] px-3.5 py-2.5 rounded-xl text-sm font-medium text-[#1a1b1f] border border-[#e3e2e7]/70 focus:outline-none focus:ring-2 focus:ring-[#007aff]" />
          </div>
        </div>

        <div class="space-y-1">
          <label class="text-xs font-semibold text-[#717786] uppercase tracking-wider">Category</label>
          <select id="categoryInput" class="w-full bg-[#f4f3f8] px-3.5 py-2.5 rounded-xl text-sm font-medium text-[#1a1b1f] border border-[#e3e2e7]/70 focus:outline-none focus:ring-2 focus:ring-[#007aff]">
            <option value="Utilities" selected>Utilities</option>
            <option value="Subscriptions">Subscriptions</option>
            <option value="Telecom">Telecom</option>
            <option value="Insurance">Insurance</option>
            <option value="Food & Groceries">Food & Groceries</option>
            <option value="General">General</option>
          </select>
        </div>

        <!-- Bill Reservation Switch -->
        <div class="pt-3 border-t border-[#eeedf3] flex items-center justify-between">
          <div>
            <h4 class="text-sm font-semibold text-[#1a1b1f]">Auto-Reserve Funds</h4>
            <p class="text-xs text-[#717786]">Ring-fence this amount from daily safe spending</p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="reserveToggle" checked class="sr-only peer" />
            <div class="w-11 h-6 bg-[#eeedf3] peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#007aff]"></div>
          </label>
        </div>
      </div>
    </div>

    <!-- Confirmation Button -->
    <button id="confirmSaveBtn" class="w-full py-3.5 px-4 bg-[#007aff] hover:bg-[#0070eb] active:scale-[0.99] text-white font-semibold text-sm rounded-2xl shadow-lg shadow-[#007aff]/30 transition-all flex items-center justify-center gap-2">
      <span class="material-symbols-outlined text-[20px]">check</span>
      Add to Budget & Reserved Pool
    </button>
  </div>

  <script>
    // Populate form with parsed OCR bill data from sessionStorage
    try {
      const pendingRaw = sessionStorage.getItem('pendingBill');
      if (pendingRaw) {
        const bill = JSON.parse(pendingRaw);
        if (bill.merchant) {
          (document.getElementById('merchantInput') as HTMLInputElement).value = bill.merchant;
          const display = document.getElementById('displayMerchant');
          if (display) display.textContent = bill.merchant;
        }
        if (bill.amount) (document.getElementById('amountInput') as HTMLInputElement).value = String(bill.amount);
        if (bill.due_date) (document.getElementById('dueDateInput') as HTMLInputElement).value = bill.due_date;
        if (bill.category) (document.getElementById('categoryInput') as HTMLSelectElement).value = bill.category;
      }
    } catch (e) {
      console.warn('Could not read pending bill:', e);
    }

    async function save() {
      const merchant = (document.getElementById('merchantInput') as HTMLInputElement).value.trim();
      const amount = parseFloat((document.getElementById('amountInput') as HTMLInputElement).value);
      const dueDate = (document.getElementById('dueDateInput') as HTMLInputElement).value;
      const category = (document.getElementById('categoryInput') as HTMLSelectElement).value;
      const isReserved = (document.getElementById('reserveToggle') as HTMLInputElement).checked;

      if (!merchant || isNaN(amount) || amount <= 0 || !dueDate) {
        alert('Please ensure vendor, amount, and due date are filled.');
        return;
      }

      try {
        const res = await fetch('/api/bills', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            merchant,
            amount,
            due_date: dueDate,
            category,
            status: isReserved ? 'reserved' : 'uncovered'
          })
        });

        sessionStorage.removeItem('pendingBill');
        window.location.href = '/reserved';
      } catch (err) {
        console.error('Save bill error:', err);
        window.location.href = '/reserved';
      }
    }

    document.getElementById('saveBillBtn')?.addEventListener('click', save);
    document.getElementById('confirmSaveBtn')?.addEventListener('click', save);
  </script>
</AppLayout>
