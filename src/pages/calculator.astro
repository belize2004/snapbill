---
import AppLayout from '../layouts/AppLayout.astro';
import { getCloudflareBindings } from '../lib/db';

export const prerender = false;

const env = await getCloudflareBindings();
const db = env?.DB;

let allBills: any[] = [];
let budgetSettings: any = {
  monthly_income: 5000.00,
  monthly_limit: 4200.00,
  current_spent: 1719.50
};

if (db) {
  try {
    const billsRes = await db.prepare("SELECT * FROM bills ORDER BY due_date ASC").all();
    allBills = billsRes.results || [];

    const budgetRes = await db.prepare("SELECT * FROM budget_settings WHERE id = 1").first();
    if (budgetRes) {
      budgetSettings = budgetRes;
    }
  } catch (e) {
    console.error("D1 Error on calculator:", e);
  }
}

// Compute remaining spendable pool
const spendablePool = Math.max(0, budgetSettings.monthly_limit - budgetSettings.current_spent);
---

<AppLayout title="Bill Coverage Calculator" activeTab="settings">
  <div class="flex flex-col w-full pb-8 space-y-5 pt-3">
    <!-- Header -->
    <div class="px-1">
      <span class="text-xs font-semibold text-[#717786] uppercase tracking-wider block mb-0.5">Automated Allocation</span>
      <h1 class="text-3xl font-bold tracking-tight text-[#1a1b1f]">Coverage Plan</h1>
    </div>

    <!-- Live Coverage Slider Card -->
    <div class="bg-white rounded-3xl p-5 shadow-sm border border-[#e3e2e7]/60 space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <span class="text-xs text-[#717786] font-medium block">Coverage Window</span>
          <h2 id="coverageDaysLabel" class="text-2xl font-bold text-[#1a1b1f] mt-0.5">Next 30 Days</h2>
        </div>
        <div class="text-right">
          <span class="text-xs text-[#717786] font-medium block">Total Ring-Fenced</span>
          <span id="quarantinedAmount" class="text-2xl font-bold text-[#007aff] tabular-nums mt-0.5">$0.00</span>
        </div>
      </div>

      <!-- Slider Control -->
      <div class="space-y-2 pt-2">
        <input type="range" id="coverageRange" min="7" max="60" value="30" step="1" class="w-full h-2 bg-[#eeedf3] rounded-lg appearance-none cursor-pointer accent-[#007aff]" />
        <div class="flex justify-between text-[11px] font-semibold text-[#717786]">
          <span class="slider-preset cursor-pointer hover:text-[#007aff]" data-days="7">7 Days</span>
          <span class="slider-preset cursor-pointer hover:text-[#007aff]" data-days="15">15 Days</span>
          <span class="slider-preset cursor-pointer text-[#007aff] font-bold" data-days="30">30 Days</span>
          <span class="slider-preset cursor-pointer hover:text-[#007aff]" data-days="60">60 Days</span>
        </div>
      </div>

      <div class="p-3.5 bg-[#f4f3f8] rounded-2xl flex items-center justify-between text-xs">
        <div>
          <span class="text-[#414755] block font-medium">Safe Daily Spending</span>
          <span class="text-[11px] text-[#717786]">After protecting selected bills</span>
        </div>
        <span id="safeDaily" class="font-bold text-[#006e28] text-base tabular-nums">$0.00 / day</span>
      </div>
    </div>

    <!-- Bill Inclusion Checklist -->
    <div class="space-y-2 pt-1">
      <div class="flex items-center justify-between px-1">
        <span class="text-xs font-semibold text-[#717786] uppercase tracking-wider">
          Bills in Scope (<span id="includedCount">0</span>)
        </span>
        <button id="toggleAllBtn" class="text-xs text-[#007aff] font-semibold active:opacity-75">
          Select All
        </button>
      </div>

      {allBills.length === 0 ? (
        <div class="bg-white rounded-2xl p-6 text-center text-sm text-[#717786] border border-[#e3e2e7]/60">
          No bills found. <a href="/add" class="text-[#007aff] font-semibold underline">Add a bill</a> or <a href="/scan" class="text-[#007aff] font-semibold underline">scan a bill</a> to start planning.
        </div>
      ) : (
        <div class="bg-white rounded-2xl shadow-sm divide-y divide-[#e3e2e7]/60 border border-[#e3e2e7]/60" id="billChecklist">
          {allBills.map((bill: any) => {
            const today = new Date();
            const due = new Date(bill.due_date);
            const diffDays = Math.ceil((due.getTime() - today.getTime()) / (1000 * 3600 * 24));
            const isDueSoon = diffDays <= 30;

            return (
              <label class="flex items-center justify-between px-4 py-3.5 cursor-pointer hover:bg-[#faf9fe] transition-colors bill-item" data-bill-id={bill.id} data-amount={bill.amount} data-due-days={diffDays}>
                <div class="flex items-center gap-3 min-w-0 flex-1">
                  <input
                    type="checkbox"
                    checked={isDueSoon}
                    class="bill-checkbox w-5 h-5 rounded text-[#007aff] accent-[#007aff] cursor-pointer"
                  />
                  <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                      <span class="text-sm font-semibold text-[#1a1b1f] truncate">{bill.merchant}</span>
                      <span class="text-[10px] px-1.5 py-0.2 bg-[#f4f3f8] text-[#717786] rounded-md font-medium">{bill.category}</span>
                    </div>
                    <span class="text-xs text-[#717786] block mt-0.5">
                      {diffDays > 0 ? `Due in ${diffDays} days` : (diffDays === 0 ? 'Due today' : `Due ${bill.due_date}`)} · Due {bill.due_date}
                    </span>
                  </div>
                </div>
                <span class="text-sm font-semibold text-[#1a1b1f] tabular-nums shrink-0 ml-3">
                  ${Number(bill.amount).toFixed(2)}
                </span>
              </label>
            );
          })}
        </div>
      )}
    </div>

    <!-- Quick Action -->
    <div class="pt-2">
      <a href="/reserved" class="w-full py-3.5 px-4 bg-[#007aff] hover:bg-[#0070eb] active:scale-[0.99] text-white font-semibold text-sm rounded-2xl shadow-lg shadow-[#007aff]/30 transition-all flex items-center justify-center gap-2">
        <span class="material-symbols-outlined text-[20px]">shield</span>
        View Ring-Fenced Vault
      </a>
    </div>
  </div>

  <script define:vars={{ spendablePool }}>
    const slider = document.getElementById('coverageRange');
    const label = document.getElementById('coverageDaysLabel');
    const amountLabel = document.getElementById('quarantinedAmount');
    const safeDailyLabel = document.getElementById('safeDaily');
    const includedCount = document.getElementById('includedCount');
    const toggleAllBtn = document.getElementById('toggleAllBtn');
    const checkboxes = document.querySelectorAll('.bill-checkbox');
    const billItems = document.querySelectorAll('.bill-item');

    function recalculate() {
      const days = parseInt(slider.value, 10);
      if (label) label.textContent = `Next ${days} Days`;

      let totalQuarantined = 0;
      let count = 0;

      billItems.forEach(item => {
        const cb = item.querySelector('.bill-checkbox');
        const amount = parseFloat(item.getAttribute('data-amount') || '0');
        if (cb && cb.checked) {
          totalQuarantined += amount;
          count++;
        }
      });

      if (amountLabel) amountLabel.textContent = `$${totalQuarantined.toFixed(2)}`;
      if (includedCount) includedCount.textContent = String(count);

      // Remaining safe daily spending calculation
      const remainingSpend = Math.max(0, spendablePool - totalQuarantined);
      const daily = remainingSpend / Math.max(1, days);
      if (safeDailyLabel) {
        safeDailyLabel.textContent = `$${daily.toFixed(2)} / day`;
      }
    }

    // Auto-check/uncheck bills according to selected days window
    function updateInclusionsByDays(days) {
      billItems.forEach(item => {
        const dueDays = parseInt(item.getAttribute('data-due-days') || '999', 10);
        const cb = item.querySelector('.bill-checkbox');
        if (cb) {
          cb.checked = (dueDays <= days && dueDays >= -7);
        }
      });
      recalculate();
    }

    slider?.addEventListener('input', (e) => {
      const days = parseInt(e.target.value, 10);
      updateInclusionsByDays(days);
    });

    document.querySelectorAll('.slider-preset').forEach(preset => {
      preset.addEventListener('click', () => {
        const days = parseInt(preset.getAttribute('data-days') || '30', 10);
        if (slider) slider.value = String(days);
        updateInclusionsByDays(days);
      });
    });

    checkboxes.forEach(cb => {
      cb.addEventListener('change', recalculate);
    });

    toggleAllBtn?.addEventListener('click', () => {
      const allChecked = Array.from(checkboxes).every(cb => cb.checked);
      checkboxes.forEach(cb => cb.checked = !allChecked);
      toggleAllBtn.textContent = allChecked ? 'Select All' : 'Deselect All';
      recalculate();
    });

    // Run initial calculation on page load
    recalculate();
  </script>
</AppLayout>
