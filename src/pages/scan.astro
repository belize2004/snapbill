---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Scan Bill or Receipt" activeTab="scan">
  <div class="flex flex-col h-[calc(100vh-140px)] w-full justify-between pt-2">
    <!-- Top Action Nav -->
    <div class="flex items-center justify-between px-2">
      <a href="/" class="w-10 h-10 rounded-full bg-white/80 backdrop-blur-md flex items-center justify-center text-[#1a1b1f] shadow-sm">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </a>
      <span class="text-sm font-semibold text-[#1a1b1f]">Camera Scanner</span>
      <a href="/add" class="text-xs font-semibold text-[#007aff] bg-white/80 backdrop-blur-md px-3 py-1.5 rounded-full shadow-sm">
        Manual Entry
      </a>
    </div>

    <!-- Live Viewport / Document Scanner Frame -->
    <div class="relative flex-1 my-4 bg-[#1a1b1f] rounded-3xl overflow-hidden shadow-inner flex items-center justify-center">
      <video id="cameraFeed" autoplay playsinline muted class="absolute inset-0 w-full h-full object-cover"></video>
      <canvas id="photoCanvas" class="hidden"></canvas>

      <!-- Fallback view if live video stream is not active -->
      <div id="cameraBlockedNotice" class="hidden absolute inset-0 bg-[#1a1b1f] flex flex-col items-center justify-center p-6 text-center text-white space-y-4 z-10">
        <div class="w-16 h-16 rounded-full bg-[#007aff]/20 flex items-center justify-center text-[#007aff]">
          <span class="material-symbols-outlined text-[36px]">photo_camera</span>
        </div>
        <div>
          <h3 class="text-base font-bold">Snap or Upload Bill</h3>
          <p class="text-xs text-white/70 max-w-xs mt-1">
            Tap the blue button below to snap a photo or upload an image.
          </p>
        </div>
      </div>

      <!-- Alignment Guidelines -->
      <div id="overlayGuidelines" class="absolute inset-6 border-2 border-dashed border-white/60 rounded-2xl pointer-events-none flex flex-col justify-between p-4 z-10">
        <div class="flex justify-between">
          <div class="w-6 h-6 border-t-2 border-l-2 border-[#007aff]"></div>
          <div class="w-6 h-6 border-t-2 border-r-2 border-[#007aff]"></div>
        </div>
        <div class="text-center">
          <span class="inline-block bg-black/60 text-white backdrop-blur-md text-xs px-3 py-1.5 rounded-full font-medium shadow">
            Align bill or receipt within frame
          </span>
        </div>
        <div class="flex justify-between">
          <div class="w-6 h-6 border-b-2 border-l-2 border-[#007aff]"></div>
          <div class="w-6 h-6 border-b-2 border-r-2 border-[#007aff]"></div>
        </div>
      </div>

      <!-- Loading / Analyzing Spinner -->
      <div id="ocrLoading" class="hidden absolute inset-0 bg-black/85 backdrop-blur-md flex flex-col items-center justify-center text-white z-30 space-y-3">
        <div class="w-12 h-12 border-4 border-[#007aff] border-t-transparent rounded-full animate-spin"></div>
        <p class="text-sm font-semibold">Extracting bill details with AI...</p>
        <p class="text-xs text-white/70" id="loadingStatus">Vendor, Total, Due Date & Line Items</p>
      </div>
    </div>

    <!-- Hidden Native Mobile Camera Input -->
    <input type="file" id="nativeCameraInput" accept="image/*" capture="environment" class="hidden" />
    <input type="file" id="fileUpload" accept="image/*" class="hidden" />

    <!-- Shutter Controls & Photo Upload Fallback -->
    <div class="flex items-center justify-around px-6 py-4 bg-white/80 backdrop-blur-xl rounded-3xl border border-[#e3e2e7]/60 shadow-sm">
      <!-- Photo Library Picker -->
      <label for="fileUpload" class="w-12 h-12 rounded-full bg-[#f4f3f8] flex items-center justify-center text-[#1a1b1f] cursor-pointer active:scale-95 transition-transform">
        <span class="material-symbols-outlined text-[24px]">photo_library</span>
      </label>

      <!-- Primary Shutter Button (Labels trigger file chooser reliably on iOS) -->
      <label for="nativeCameraInput" id="captureBtnLabel" class="w-18 h-18 rounded-full border-4 border-[#007aff] p-1 flex items-center justify-center active:scale-90 transition-transform cursor-pointer">
        <div class="w-14 h-14 rounded-full bg-[#007aff] shadow-md"></div>
      </label>

      <!-- Manual Add Shortcut -->
      <a href="/add" class="w-12 h-12 rounded-full bg-[#f4f3f8] flex items-center justify-center text-[#007aff] active:scale-95 transition-transform">
        <span class="material-symbols-outlined text-[24px]">edit</span>
      </a>
    </div>
  </div>

  <script>
    const video = document.getElementById('cameraFeed') as HTMLVideoElement;
    const canvas = document.getElementById('photoCanvas') as HTMLCanvasElement;
    const captureBtnLabel = document.getElementById('captureBtnLabel');
    const fileUpload = document.getElementById('fileUpload') as HTMLInputElement;
    const nativeCameraInput = document.getElementById('nativeCameraInput') as HTMLInputElement;
    const ocrLoading = document.getElementById('ocrLoading');
    const loadingStatus = document.getElementById('loadingStatus');
    const cameraBlockedNotice = document.getElementById('cameraBlockedNotice');
    let hasLiveStream = false;

    async function initCamera() {
      try {
        if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
          const stream = await navigator.mediaDevices.getUserMedia({
            video: { facingMode: { ideal: 'environment' } }
          });
          video.srcObject = stream;
          hasLiveStream = true;
        } else {
          showCameraFallback();
        }
      } catch (e) {
        showCameraFallback();
      }
    }

    function showCameraFallback() {
      hasLiveStream = false;
      if (cameraBlockedNotice) cameraBlockedNotice.classList.remove('hidden');
    }

    initCamera();

    function compressAndSend(source: CanvasImageSource, srcWidth: number, srcHeight: number) {
      if (ocrLoading) ocrLoading.classList.remove('hidden');
      if (loadingStatus) loadingStatus.textContent = 'Optimizing image...';

      const MAX_DIM = 900;
      let width = srcWidth;
      let height = srcHeight;

      if (width > height) {
        if (width > MAX_DIM) {
          height = Math.round((height * MAX_DIM) / width);
          width = MAX_DIM;
        }
      } else {
        if (height > MAX_DIM) {
          width = Math.round((width * MAX_DIM) / height);
          height = MAX_DIM;
        }
      }

      canvas.width = width;
      canvas.height = height;
      const ctx = canvas.getContext('2d');
      ctx?.drawImage(source, 0, 0, width, height);

      const compressedDataUrl = canvas.toDataURL('image/jpeg', 0.8);
      sendToOCR(compressedDataUrl);
    }

    function processFile(file: File) {
      const reader = new FileReader();
      reader.onload = (e) => {
        const img = new Image();
        img.onload = () => {
          compressAndSend(img, img.width, img.height);
        };
        img.src = e.target?.result as string;
      };
      reader.readAsDataURL(file);
    }

    async function sendToOCR(dataUrl: string) {
      if (loadingStatus) loadingStatus.textContent = 'AI extracting vendor & amount...';

      try {
        const res = await fetch('/api/ocr', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ image: dataUrl })
        });
        const result = await res.json();
        sessionStorage.setItem('pendingBill', JSON.stringify(result));
        window.location.href = '/review';
      } catch (err: any) {
        console.error('OCR Error:', err);
        sessionStorage.setItem('pendingBill', JSON.stringify({ error: 'OCR connection failed' }));
        window.location.href = '/review';
      }
    }

    // Capture from live video if active, otherwise label triggers native camera input
    captureBtnLabel?.addEventListener('click', (e) => {
      if (hasLiveStream && video.videoWidth > 0) {
        e.preventDefault();
        compressAndSend(video, video.videoWidth, video.videoHeight);
      }
    });

    nativeCameraInput?.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement)?.files?.[0];
      if (file) processFile(file);
    });

    fileUpload?.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement)?.files?.[0];
      if (file) processFile(file);
    });
  </script>
</AppLayout>
