---
import AppLayout from '../layouts/AppLayout.astro';
import { getCloudflareBindings } from '../lib/db';

export const prerender = false;

const env = await getCloudflareBindings();
const db = env?.DB;

let reservedBills: any[] = [];
let totalReserved = 0.00;

if (db) {
  try {
    const res = await db.prepare("SELECT * FROM bills WHERE status = 'reserved' ORDER BY due_date ASC").all();
    reservedBills = res.results || [];
    totalReserved = reservedBills.reduce((acc: number, b: any) => acc + Number(b.amount || 0), 0);
  } catch (e) {
    console.error("D1 Error:", e);
  }
}
---

<AppLayout title="Reserved Bills" activeTab="reserved">
  <div class="flex flex-col w-full pb-8 space-y-5 pt-3">
    <!-- Header -->
    <div class="flex items-end justify-between px-1">
      <div>
        <span class="text-xs font-semibold text-[#717786] uppercase tracking-wider block mb-0.5">Ring-Fenced Funds</span>
        <h1 class="text-3xl font-bold tracking-tight text-[#1a1b1f]">Reserved</h1>
      </div>
      <div class="flex items-center gap-2">
        <a href="/add" class="flex items-center gap-1 bg-[#007aff] text-white px-3 py-1.5 rounded-full text-xs font-semibold shadow-sm active:scale-95 transition-transform">
          <span class="material-symbols-outlined text-[16px]">add</span>
          Add Bill
        </a>
        <a href="/calculator" class="flex items-center gap-1 bg-[#d8e2ff] text-[#007aff] px-3 py-1.5 rounded-full text-xs font-semibold active:scale-95 transition-transform">
          <span class="material-symbols-outlined text-[16px]">tune</span>
          Plan
        </a>
      </div>
    </div>

    <!-- Reserved Pool Summary Hero -->
    <div class="bg-white rounded-3xl p-5 shadow-sm border border-[#e3e2e7]/60 space-y-3">
      <div class="flex items-start justify-between">
        <div>
          <span class="text-xs text-[#717786] font-medium block">Total Protected for Bills</span>
          <div class="flex items-baseline gap-1 mt-1">
            <span class="text-3xl font-bold tracking-tight text-[#1a1b1f] tabular-nums" id="heroTotal">
              ${totalReserved.toFixed(2)}
            </span>
          </div>
        </div>
        <div class="h-7 px-2.5 rounded-full bg-[#72fe88]/30 flex items-center gap-1 text-[#006e28] text-xs font-medium">
          <span class="material-symbols-outlined text-[14px]">shield</span>
          <span id="heroBadge">{reservedBills.length > 0 ? '100% Protected' : 'No Bills'}</span>
        </div>
      </div>
      <p class="text-xs text-[#717786]">
        These funds are quarantined from your daily spending balance so upcoming autopays never overdraft or bounce.
      </p>
    </div>

    <!-- Segmented Tabs (Apple HIG Segmented Control) -->
    <div class="flex bg-[#eeedf3] p-1 rounded-2xl">
      <button class="flex-1 py-1.5 text-xs font-semibold rounded-xl bg-white text-[#1a1b1f] shadow-sm">
        Pending (<span id="pendingCount">{reservedBills.length}</span>)
      </button>
      <button class="flex-1 py-1.5 text-xs font-semibold rounded-xl text-[#717786] hover:text-[#1a1b1f]">
        Settled & Paid (0)
      </button>
    </div>

    <!-- Reserved Inset List -->
    {reservedBills.length === 0 ? (
      <div class="bg-white rounded-2xl shadow-sm border border-[#e3e2e7]/60 p-8 text-center space-y-3" id="emptyState">
        <div class="w-12 h-12 rounded-full bg-[#eeedf3] flex items-center justify-center text-[#717786] mx-auto">
          <span class="material-symbols-outlined text-[24px]">receipt_long</span>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-[#1a1b1f]">No bills added yet</h3>
          <p class="text-xs text-[#717786] mt-0.5">Add your first bill manually or scan a receipt to ring-fence funds.</p>
        </div>
        <a href="/add" class="inline-flex items-center gap-1 bg-[#007aff] text-white px-4 py-2 rounded-xl text-xs font-semibold shadow-sm active:scale-95 transition-transform">
          <span class="material-symbols-outlined text-[16px]">add</span>
          Add First Bill
        </a>
      </div>
    ) : (
      <div class="bg-white rounded-2xl shadow-sm overflow-hidden divide-y divide-[#e3e2e7]/60 border border-[#e3e2e7]/60" id="billsList">
        {reservedBills.map((bill: any) => (
          <div class="flex items-center justify-between px-4 py-3.5 transition-colors group" id={`bill-row-${bill.id}`}>
            <div
              class="flex items-center gap-3 min-w-0 flex-1 cursor-pointer edit-bill-trigger"
              data-id={bill.id}
              data-merchant={bill.merchant}
              data-amount={bill.amount}
              data-due-date={bill.due_date}
              data-category={bill.category}
              title="Tap to edit bill"
            >
              <div class="w-10 h-10 rounded-xl bg-[#eeedf3] flex items-center justify-center text-[#414755] shrink-0 group-hover:bg-[#d8e2ff] group-hover:text-[#007aff] transition-colors">
                <span class="material-symbols-outlined text-[20px]">calendar_month</span>
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-1.5">
                  <span class="text-sm font-semibold text-[#1a1b1f] truncate group-hover:text-[#007aff] transition-colors">{bill.merchant}</span>
                  <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-[#72fe88]/25 text-[#006e28] text-[10px] font-semibold">
                    Funded
                  </span>
                </div>
                <span class="text-xs text-[#717786] block mt-0.5">Due {bill.due_date} · {bill.category}</span>
              </div>
            </div>
            
            <div class="flex items-center gap-2.5 shrink-0 ml-3">
              <span
                class="text-sm font-semibold text-[#1a1b1f] tabular-nums cursor-pointer edit-bill-trigger"
                data-id={bill.id}
                data-merchant={bill.merchant}
                data-amount={bill.amount}
                data-due-date={bill.due_date}
                data-category={bill.category}
              >
                ${Number(bill.amount).toFixed(2)}
              </span>

              <!-- Edit Quick Action -->
              <button
                type="button"
                data-id={bill.id}
                data-merchant={bill.merchant}
                data-amount={bill.amount}
                data-due-date={bill.due_date}
                data-category={bill.category}
                class="edit-bill-btn w-8 h-8 rounded-full bg-[#f4f3f8] hover:bg-[#d8e2ff] text-[#007aff] flex items-center justify-center transition-colors active:scale-90"
                title={`Edit ${bill.merchant}`}
              >
                <span class="material-symbols-outlined text-[17px]">edit</span>
              </button>

              <!-- Delete / Remove Action Button -->
              <button
                type="button"
                data-bill-id={bill.id}
                data-merchant={bill.merchant}
                data-amount={bill.amount}
                class="delete-bill-btn w-8 h-8 rounded-full bg-red-50 hover:bg-red-100 text-red-600 flex items-center justify-center transition-colors active:scale-90"
                title={`Remove ${bill.merchant}`}
              >
                <span class="material-symbols-outlined text-[17px]">delete</span>
              </button>
            </div>
          </div>
        ))}
      </div>
    )}

    <!-- Apple HIG Edit Modal Sheet -->
    <div id="editModal" class="hidden fixed inset-0 z-[100] flex items-end sm:items-center justify-center bg-black/60 backdrop-blur-sm p-0 sm:p-4 pb-20 sm:pb-4">
      <div class="bg-white w-full max-w-md rounded-t-3xl sm:rounded-3xl p-6 pb-8 shadow-2xl space-y-4 animate-in fade-in slide-in-from-bottom duration-200 max-h-[85vh] overflow-y-auto">
        <div class="flex items-center justify-between pb-2 border-b border-[#eeedf3]">
          <h3 class="text-base font-bold text-[#1a1b1f]">Edit Bill Details</h3>
          <button type="button" id="closeModalBtn" class="w-8 h-8 rounded-full bg-[#f4f3f8] flex items-center justify-center text-[#717786]">
            <span class="material-symbols-outlined text-[18px]">close</span>
          </button>
        </div>

        <form id="editBillForm" class="space-y-3.5">
          <input type="hidden" id="editBillId" />

          <div>
            <label class="text-xs font-semibold text-[#717786] uppercase tracking-wider block mb-1">Vendor / Biller</label>
            <input type="text" id="editMerchant" required class="w-full bg-[#f4f3f8] px-3.5 py-2.5 rounded-xl text-sm font-semibold text-[#1a1b1f] border border-[#e3e2e7]/70 focus:outline-none focus:ring-2 focus:ring-[#007aff]" />
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="text-xs font-semibold text-[#717786] uppercase tracking-wider block mb-1">Amount ($)</label>
              <input type="number" step="0.01" min="0.01" id="editAmount" required class="w-full bg-[#f4f3f8] px-3.5 py-2.5 rounded-xl text-sm font-bold text-[#1a1b1f] border border-[#e3e2e7]/70 focus:outline-none focus:ring-2 focus:ring-[#007aff]" />
            </div>
            <div>
              <label class="text-xs font-semibold text-[#717786] uppercase tracking-wider block mb-1">Due Date</label>
              <input type="date" id="editDueDate" required class="w-full bg-[#f4f3f8] px-3.5 py-2.5 rounded-xl text-sm font-medium text-[#1a1b1f] border border-[#e3e2e7]/70 focus:outline-none focus:ring-2 focus:ring-[#007aff]" />
            </div>
          </div>

          <div>
            <label class="text-xs font-semibold text-[#717786] uppercase tracking-wider block mb-1">Category</label>
            <select id="editCategory" class="w-full bg-[#f4f3f8] px-3.5 py-2.5 rounded-xl text-sm font-medium text-[#1a1b1f] border border-[#e3e2e7]/70 focus:outline-none focus:ring-2 focus:ring-[#007aff]">
              <option value="Utilities">Utilities</option>
              <option value="Subscriptions">Subscriptions</option>
              <option value="Telecom">Telecom</option>
              <option value="Insurance">Insurance</option>
              <option value="Food & Groceries">Food & Groceries</option>
              <option value="General">General</option>
            </select>
          </div>

          <div class="pt-2 flex gap-3">
            <button type="button" id="cancelModalBtn" class="flex-1 py-3 px-4 rounded-xl bg-[#f4f3f8] text-sm font-semibold text-[#414755] active:scale-95 transition-transform">
              Cancel
            </button>
            <button type="submit" id="saveEditBtn" class="flex-1 py-3 px-4 rounded-xl bg-[#007aff] text-white text-sm font-semibold shadow-md shadow-[#007aff]/30 active:scale-95 transition-transform">
              Save Changes
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    const modal = document.getElementById('editModal');
    const form = document.getElementById('editBillForm') as HTMLFormElement;
    const billIdInput = document.getElementById('editBillId') as HTMLInputElement;
    const merchantInput = document.getElementById('editMerchant') as HTMLInputElement;
    const amountInput = document.getElementById('editAmount') as HTMLInputElement;
    const dueDateInput = document.getElementById('editDueDate') as HTMLInputElement;
    const categorySelect = document.getElementById('editCategory') as HTMLSelectElement;
    const saveBtn = document.getElementById('saveEditBtn') as HTMLButtonElement;

    function openEdit(id: string, merchant: string, amount: string, dueDate: string, category: string) {
      if (!modal) return;
      billIdInput.value = id;
      merchantInput.value = merchant;
      amountInput.value = amount;
      dueDateInput.value = dueDate;
      categorySelect.value = category || 'General';
      modal.classList.remove('hidden');
    }

    function closeEdit() {
      if (modal) modal.classList.add('hidden');
    }

    document.querySelectorAll('.edit-bill-btn, .edit-bill-trigger').forEach(el => {
      el.addEventListener('click', (e) => {
        e.stopPropagation();
        const target = e.currentTarget as HTMLElement;
        const id = target.getAttribute('data-id') || '';
        const merchant = target.getAttribute('data-merchant') || '';
        const amount = target.getAttribute('data-amount') || '';
        const dueDate = target.getAttribute('data-due-date') || '';
        const category = target.getAttribute('data-category') || 'General';
        openEdit(id, merchant, amount, dueDate, category);
      });
    });

    document.getElementById('closeModalBtn')?.addEventListener('click', closeEdit);
    document.getElementById('cancelModalBtn')?.addEventListener('click', closeEdit);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeEdit();
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = billIdInput.value;
      const merchant = merchantInput.value.trim();
      const amount = parseFloat(amountInput.value);
      const dueDate = dueDateInput.value;
      const category = categorySelect.value;

      if (!id || !merchant || isNaN(amount) || amount <= 0 || !dueDate) {
        alert('Please fill out all required fields.');
        return;
      }

      saveBtn.disabled = true;
      saveBtn.textContent = 'Saving...';

      try {
        const res = await fetch('/api/bills', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id,
            merchant,
            amount,
            due_date: dueDate,
            category,
            status: 'reserved'
          })
        });

        if (res.ok) {
          window.location.reload();
        } else {
          const err = await res.json();
          alert('Could not update bill: ' + (err.error || 'Server error'));
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save Changes';
        }
      } catch (err: any) {
        alert('Network error updating bill: ' + err.message);
        saveBtn.disabled = false;
        saveBtn.textContent = 'Save Changes';
      }
    });

    // Delete handler
    document.querySelectorAll('.delete-bill-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const target = e.currentTarget as HTMLButtonElement;
        const id = target.getAttribute('data-bill-id');
        const merchant = target.getAttribute('data-merchant') || 'this bill';
        const amount = parseFloat(target.getAttribute('data-amount') || '0');

        if (!id) return;

        const confirmed = confirm(`Are you sure you want to remove "${merchant}" ($${amount.toFixed(2)}) from your reserved pool?`);
        if (!confirmed) return;

        target.disabled = true;
        target.innerHTML = '<span class="material-symbols-outlined text-[16px] animate-spin">refresh</span>';

        try {
          const res = await fetch(`/api/bills?id=${encodeURIComponent(id)}`, {
            method: 'DELETE'
          });

          if (res.ok) {
            const row = document.getElementById(`bill-row-${id}`);
            if (row) {
              row.style.transition = 'opacity 0.25s, transform 0.25s';
              row.style.opacity = '0';
              row.style.transform = 'translateX(20px)';
              setTimeout(() => {
                row.remove();
                window.location.reload();
              }, 250);
            } else {
              window.location.reload();
            }
          } else {
            alert('Failed to delete bill from database.');
            target.disabled = false;
            target.innerHTML = '<span class="material-symbols-outlined text-[18px]">delete</span>';
          }
        } catch (err: any) {
          alert('Network error while deleting bill: ' + err.message);
          target.disabled = false;
          target.innerHTML = '<span class="material-symbols-outlined text-[18px]">delete</span>';
        }
      });
    });
  </script>
</AppLayout>
